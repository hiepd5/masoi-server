# ==============================================================================
# MA SÓI ONLINE 3D — CẤU HÌNH MÔI TRƯỜNG BACKEND SERVER (V4.1 ZERO-TRUST)
# Sao chép file này thành `.env` trên máy Local hoặc cấu hình trên Render Env
# TUYỆT ĐỐI KHÔNG COMMIT FILE `.env` THẬT LÊN GITHUB!
# ==============================================================================

PORT=3001
NODE_ENV=development

# ── 1. LIVEKIT CLOUD VOICE ROOM (Bắt buộc cho Voice Chat) ─────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ── 2. VOICESTUDIO CÁ NHÂN (RTX 3090 Local hoặc Ngrok Tunnel riêng) ───────────
# Trên máy Local: http://127.0.0.1:3900
# Trên Render Cloud: Điền URL Ngrok cá nhân trong mục Environment của Render
VOICESTUDIO_URL=http://127.0.0.1:3900
VOICESTUDIO_VOICE_ID=b5d182f3
VOICESTUDIO_SHARED_SECRET=replace_with_random_shared_secret

# ── 3. BẢO MẬT CORS & QUẢN TRỊ VẬN HÀNH ───────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://masoi.hiepd5.com,https://www.masoi.hiepd5.com,capacitor://localhost,https://localhost,http://localhost:5173
ADMIN_STATS_TOKEN=replace_with_admin_stats_token

# ── 4. CÔNG CỤ STUDIO NỘI BỘ (CHỈ BẬT =1 TRÊN MÁY DEV LOCAL, TẮT TRÊN RENDER) ─
ALLOW_LOCAL_STUDIO=1
